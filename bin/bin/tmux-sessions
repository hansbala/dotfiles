#!/bin/sh
# Fuzzy session switcher for tmux, intended to run inside a popup.
# Bound to prefix+s in tmux.conf.
#
# Usage:
#   tmux-sessions [client-name]     interactive picker
#   tmux-sessions --preview NAME    live snapshot of the panes in the
#                                   session's active window

set -eu

# Last $2 non-blank lines of a pane, colours preserved, trailing
# whitespace trimmed. capture-pane -e pads lines to the full pane width,
# so a trailing reset stops stale backgrounds bleeding across the preview.
snapshot() {
  tmux capture-pane -ep -t "$1" |
    awk -v n="$2" '
      function plain(s) { gsub(/\033\[[0-9;]*m/, "", s); return s }
      # Peel trailing padding, which alternates spaces and colour resets.
      function trim(s,  prev) {
        while (1) {
          prev = s
          sub(/[[:space:]]+$/, "", s)
          sub(/\033\[[0-9;]*m$/, "", s)
          if (s == prev) return s
        }
      }
      { line[NR] = trim($0) }
      END {
        last = NR
        while (last > 1 && plain(line[last]) ~ /^[[:space:]]*$/) last--
        first = last - n + 1
        if (first < 1) first = 1
        for (i = first; i <= last; i++) print line[i] "\033[0m"
      }'
}

preview() {
  session="$1"
  active_window=$(tmux display-message -p -t "$session" '#{window_id}')
  panes=$(tmux list-panes -t "$active_window" -F '#{pane_id}')

  printf '\033[1m%s\033[0m' "$session"
  state=$(tmux display-message -p -t "$session" '#{?session_attached,attached,}')
  if [ -n "$state" ]; then printf '  \033[2m· %s\033[0m' "$state"; fi
  printf '\n\033[2m%s\033[0m\n' '────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────'

  # Share the preview height across the active window's panes.
  # Keep this in step with the popup height (-h) in tmux.conf.
  pane_n=$(printf '%s\n' "$panes" | wc -l | tr -d ' ')
  per_pane=$((30 / pane_n))
  if [ "$per_pane" -lt 3 ]; then per_pane=3; fi
  if [ "$per_pane" -gt 30 ]; then per_pane=30; fi

  for pid in $panes; do
    command=$(tmux display-message -p -t "$pid" '#{pane_current_command}')
    path=$(tmux display-message -p -t "$pid" '#{pane_current_path}' | sed "s|$HOME|~|")
    if [ "$(tmux display-message -p -t "$pid" '#{?pane_active,yes,}')" = yes ]; then
      marker='▸'
    else
      marker=' '
    fi
    printf '\033[2m%s %s  %s\033[0m\n' "$marker" "$command" "$path"
    snapshot "$pid" "$per_pane"
  done
}

case "${1:-}" in
  --preview)
    preview "${2:?session name required}"
    exit 0
    ;;
  '') client='' ;;
  *) client="$1" ;;
esac

[ -n "$client" ] || client="$(tmux display-message -p '#{client_name}')"

selected=$(
  tmux list-sessions -F '#{session_activity}	#{session_name}' |
    sort -rn |
    cut -f2- |
    fzf --reverse --no-sort --info=hidden \
      --height=100% --border=none \
      --prompt='> ' \
      --preview 'tmux-sessions --preview {1}' \
      --preview-window 'right,70%,border-left,nowrap,noinfo'
) || exit 0

[ -n "$selected" ] || exit 0

name=$selected
[ "$name" = "$(tmux display-message -p -c "$client" '#{session_name}')" ] && exit 0

tmux switch-client -c "$client" -t "$name"
